{
  "name": "@viral-video-creator/swap-list",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "verify": "node --test scripts/build.test.mjs",
    "check": "node scripts/build.mjs && hyperframes lint . && hyperframes check .",
    "preview": "node scripts/build.mjs && hyperframes preview . --port 3022",
    "render": "node scripts/build.mjs && hyperframes render . --output renders/swap-list.mp4"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "gsap": "3.14.2",
    "hyperframes": "0.9.98"
  }
}
