{
  "name": "viral-video-creator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "templates/*"
  ],
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:editorial-explainer": "node scripts/setup.mjs",
    "start": "pnpm dev:editorial-explainer",
    "generate:editorial-explainer": "node templates/editorial-explainer/scripts/generate.mjs",
    "clean:editorial-explainer": "node templates/editorial-explainer/scripts/clean.mjs",
    "dev:editorial-explainer": "node templates/editorial-explainer/scripts/template-editor.mjs",
    "preview:editorial-explainer": "node templates/editorial-explainer/scripts/hyperframes-project.mjs start",
    "build:editorial-explainer": "pnpm --filter @viral-video-creator/editorial-explainer build",
    "render:editorial-explainer": "pnpm --filter @viral-video-creator/editorial-explainer render",
    "check:editorial-explainer": "pnpm --filter @viral-video-creator/editorial-explainer check",
    "sam2:test": "pnpm --filter @viral-video-creator/editorial-explainer sam2:test",
    "sam2:prepare": "pnpm --filter @viral-video-creator/editorial-explainer sam2:prepare",
    "build:prompt-recipe": "pnpm --filter @viral-video-creator/prompt-recipe build",
    "preview:prompt-recipe": "pnpm --filter @viral-video-creator/prompt-recipe preview",
    "render:prompt-recipe": "pnpm --filter @viral-video-creator/prompt-recipe render",
    "check:prompt-recipe": "pnpm --filter @viral-video-creator/prompt-recipe check",
    "build:prompt-recipe-advanced": "pnpm --filter @viral-video-creator/prompt-recipe-advanced build",
    "preview:prompt-recipe-advanced": "pnpm --filter @viral-video-creator/prompt-recipe-advanced preview",
    "render:prompt-recipe-advanced": "pnpm --filter @viral-video-creator/prompt-recipe-advanced render",
    "check:prompt-recipe-advanced": "pnpm --filter @viral-video-creator/prompt-recipe-advanced check",
    "build:quickcut-tutorial": "pnpm --filter @viral-video-creator/quickcut-tutorial build",
    "preview:quickcut-tutorial": "pnpm --filter @viral-video-creator/quickcut-tutorial preview",
    "render:quickcut-tutorial": "pnpm --filter @viral-video-creator/quickcut-tutorial render",
    "check:quickcut-tutorial": "pnpm --filter @viral-video-creator/quickcut-tutorial check",
    "transcribe:quickcut-tutorial": "pnpm --filter @viral-video-creator/quickcut-tutorial transcribe",
    "setup:sam2": "node scripts/setup.mjs --sam2-only",
    "test:setup": "node --test scripts/setup.test.mjs",
    "verify": "node scripts/verify-monorepo.mjs"
  },
  "packageManager": "pnpm@10.14.0"
}
